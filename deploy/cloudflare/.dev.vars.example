# The secrets this installation sets (`wrangler secret bulk` or `wrangler secret
# put`; Deploy to Cloudflare asks for them from this file). What each is:
# package.json, under "cloudflare.bindings", and
# https://github.com/sagikazarmark/rafi/blob/main/docs/reference/configuration.md
RAFI_PUBLIC_URL=
RAFI_ENGINE_INGRESS_URL=
RAFI_ENGINE_API_KEY=
RAFI_RESTATE_ENDPOINT__IDENTITY_KEYS=
RAFI_ALTCHA_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
RAFI_OPERATOR_NAME=
RAFI_OPERATOR_EMAIL=
RAFI_TERMS_VERSION=
RAFI_PRIVACY_VERSION=
