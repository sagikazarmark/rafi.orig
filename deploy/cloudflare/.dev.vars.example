# The app Worker's secrets. Copy to .dev.vars (never commit it), fill in, and
# set them once before the first deploy (INSTALL.md, step 8):
#   npx -y wrangler secret bulk .dev.vars -c wrangler.app.toml
# Optional settings: https://github.com/sagikazarmark/rafi/blob/main/docs/reference/configuration.md

# The public origin, no trailing slash (https://raffle.example.org).
RAFI_PUBLIC_URL=

# Restate Cloud: the ingress URL (https://<env>.env.<region>.restate.cloud:8080) and an API key.
RESTATE_INGRESS_URL=
RESTATE_INGRESS_API_KEY=

# Random, 32+ characters (openssl rand -hex 32). Never rotate during an event.
RAFI_POW_KEY=

# Clerk: sk_live_… and pk_live_….
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# The operator, named in every raffle's privacy notice.
RAFI_OPERATOR_NAME=
RAFI_OPERATOR_EMAIL=
