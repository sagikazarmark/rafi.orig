# This installation's secrets: the app Worker's (the engine and live Workers
# have none). Copy to .prod.vars (ignored by git), fill it in, and run
# `npx -y wrangler secret bulk .prod.vars -c app.wrangler.toml` once, before
# the first deploy (after `npm install`, for package.json's wrangler; with
# CLOUDFLARE_ENV=<name> for a Wrangler environment's installation): it
# creates the app Worker with them, and deploys keep them. Change one later
# with `npx -y wrangler secret put <NAME> -c app.wrangler.toml`. Then delete
# the file.
# The reference, with the optional settings and their defaults:
# https://github.com/sagikazarmark/rafi/blob/main/docs/reference/configuration.md

# The public origin, no trailing slash: https://raffle.example.org. QR codes
# and links use it; Clerk must allow it.
RAFI_PUBLIC_URL=

# Your Restate Cloud environment: its ingress URL
# (https://<env>.env.<region>.restate.cloud:8080) and an API key with ingress access.
# Its public key, which the engine checks Restate's requests against, is in
# engine.wrangler.toml.
RAFI_ENGINE_INGRESS_URL=
RAFI_ENGINE_API_KEY=

# The proof-of-work key: random, 32 characters or more (openssl rand -hex 32).
# Never rotate it during an event.
RAFI_POW_KEY=

# Your Clerk application's keys (sk_live_…, pk_live_…). The publishable key
# isn't secret, but it is yours: the web app signs organizers in with it.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Who runs this installation (a legal name), named as the processor in every
# raffle's privacy notice, and the contact for privacy matters.
RAFI_OPERATOR_NAME=
RAFI_OPERATOR_EMAIL=

# The versions of legal/terms.md and legal/privacy.md, e.g. 2026-10. A changed
# document is a new version.
RAFI_TERMS_VERSION=
RAFI_PRIVACY_VERSION=
