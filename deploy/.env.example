# The domain pointing at this VM (QR codes and links use it); Caddy gets its certificate automatically.
RAFI_DOMAIN=raffle.example.org
# Optional: every name the app answers to (comma separated; default RAFI_DOMAIN), and where Restate
# reaches the draw engine (default RAFI_DOMAIN:9080).
# RAFI_HOSTS=raffle.example.org, www.raffle.example.org
# RESTATE_ENDPOINT_HOSTS=raffle.example.org:9080

# Clerk (organizer login). The publishable key is baked into the build.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# HMAC key for the proof-of-work challenge: `openssl rand -hex 32`.
RAFI_ALTCHA_KEY=change-me

# Restate Cloud: the environment's ingress, an API key with ingress access, and the
# environment's request signing key (Developers > Security), which restate-rafi verifies.
RESTATE_INGRESS_URL=https://<env-id>.env.eu.restate.cloud:8080
RESTATE_API_KEY=key_...
RESTATE_IDENTITY_KEYS=publickeyv1_...

# Automatic erasure of personal data after a raffle finishes (off unless set to 1).
# RAFI_RETENTION=1
# Days until it is erased:
RAFI_RETENTION_DAYS=30
RAFI_RETENTION_WINNERS_DAYS=90
