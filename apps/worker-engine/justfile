# Rafi's raffle engine Worker (production): the Restate endpoint under
# /restate, binding the app's database and the rooms Worker's RaffleRoom class. Local
# development runs the engine inside the combined Worker (apps/worker).

# List the recipes.
[private]
default:
    @just --list --unsorted

# Build the Worker as `wrangler deploy` builds it.
build:
    worker-build --release

# Validate the Worker's shape without deploying: the configuration, every binding and the bundle.
dry-run:
    wrangler deploy --dry-run

# The engine Worker as a release ships it, into `out` (a release's engine/): build/ (the Worker).
artifact out: build
    #!/usr/bin/env bash
    set -euo pipefail
    out="{{ out }}"
    rm -rf "${out:?}"
    mkdir -p "$out"
    cp -R build "$out/build"
    rm -f "$out/build/.gitignore"
