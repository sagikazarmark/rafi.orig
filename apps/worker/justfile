# Rafi on Cloudflare Workers, the app and the raffle engine in one Worker, for
# local development (production runs three, apps/worker-app,
# apps/worker-engine and apps/worker-live, which a release ships: `just cloudflare-release` at the
# repository root). Locally (`just dev`): the static files, the D1
# migrations, then `wrangler dev --env dev` (dev auth, the mock chain, the
# raffle engine in the same Worker under /restate), with the Worker's local
# state (D1, Durable Objects) in .wrangler-state at the repository root, as
# docs/development/getting-started.md has it. The static files are the app
# Worker's too. The checks under wrangler dev are `just workers`.

state := "../../.wrangler-state"

# List the recipes.
[private]
default:
    @just --list --unsorted

# Assemble the static files Workers Assets serves (worker-assets/): the web app bundle (but its index.html, which the Worker compiles in), the participant build and the legal documents from RAFI_DOCS_DIR (absolute; the templates when unset, which a production Worker refuses).
assets:
    #!/usr/bin/env bash
    set -euo pipefail
    public=../../target/dx/rafi-web/release/web/public
    docs="${RAFI_DOCS_DIR:-../../deploy/cloudflare/legal}"
    {{ just_executable() }} ../web/ build
    {{ just_executable() }} ../participant/ build
    rm -rf worker-assets
    mkdir -p worker-assets/legal worker-assets/participant
    cp -R "$public/." worker-assets/
    # The web app's index.html is compiled into the Worker, which serves it
    # with its Content-Security-Policy; among the files, Assets would serve
    # it without one.
    rm worker-assets/index.html
    # The participant's hashed assets and its fallback; not its index.html,
    # the page's loader, which the Worker has compiled in.
    cp -R ../participant/dist/public/assets worker-assets/participant/assets
    cp ../participant/dist/public/fallback.js worker-assets/participant/
    cp "$docs/terms.md" "$docs/privacy.md" worker-assets/legal/
    # Cloudflare compresses at the edge; the precompressed variants (the web
    # app's and the participant's) are for the native server and would only
    # be served as files here.
    find worker-assets -type f \( -name '*.gz' -o -name '*.br' \) -delete
    cp _headers worker-assets/

# Build the Worker as `wrangler deploy` builds it (`just build dev` as `wrangler dev --env dev` does).
build features="":
    worker-build --release {{ if features == "" { "" } else { "--features " + features } }}

# Apply the D1 migrations to the local database.
migrate:
    wrangler d1 migrations apply rafi --local --env dev --persist-to {{ state }}

# Run the Worker at http://127.0.0.1:8787: the static files when there are none yet (`just assets` after a change), the migrations, then wrangler dev.
dev: migrate
    test -d worker-assets || {{ just_executable() }} assets
    wrangler dev --env dev --persist-to {{ state }}

# Validate the production shape without deploying: the configuration, every binding, the bundle and the static files.
dry-run:
    wrangler deploy --dry-run
