# The participant page's WebAssembly. `just build` has dx bundle it into
# dist/public: the module and its glue under assets/, named by their hash,
# fallback.js as it is, and index.html, the page's loader, which rafi-server
# compiles in. `just check` then holds the build to its contract and its
# budget; the repository's recipes, devenv and CI run that. Needs dx 0.7.10,
# with wasm-bindgen-cli at the version in Cargo.lock and wasm-opt (binaryen),
# as the devenv shell has them.

dist := "dist"
public := dist / "public"
stage := dist / ".build"

# List the recipes.
[private]
default:
    @just --list --unsorted

# Build into dist/public: staged, gzipped next to dx's brotli, moved into place only when it differs from the build there.
build:
    #!/usr/bin/env bash
    set -euo pipefail
    # dx's release defaults would keep the DWARF sections in and append its
    # own loader to index.html; the profile (opt-level z) is the workspace's
    # wasm-release, wasm-opt's flags are Dioxus.toml's. dx leaves earlier
    # bundles (other hashes) in its own output: start empty. It writes
    # `public/` under the directory it is given: the build is staged, and
    # moved into place only when it differs from the one there, so a build of
    # the same sources (the repository's recipes run `check` first) doesn't
    # move index.html and make the server compile again for nothing; `devenv
    # up` watches dist for a new index.html, which this never deletes.
    rm -rf {{ stage }} ../../target/dx/rafi-participant/release/web/public
    dx bundle --platform web --release --locked --debug-symbols false --inject-loading-scripts false --out-dir {{ stage }}
    # gzip next to dx's brotli, for the native server (tower-http serves
    # `x.br` or `x.gz` for `x` when the browser accepts it; Cloudflare
    # compresses at the edge). The fallback, which dx copies as it is, gets
    # brotli here too when the tool is there.
    for f in {{ stage }}/public/assets/*.js {{ stage }}/public/assets/*.wasm {{ stage }}/public/fallback.js; do
        gzip -9 -k -n -f "$f"
        if [ ! -f "$f.br" ] && command -v brotli >/dev/null 2>&1; then brotli -9 -k -f "$f"; fi
    done
    if [ -d {{ public }} ] && diff -rq {{ stage }}/public {{ public }} >/dev/null 2>&1; then
        echo "rafi-participant: unchanged"
    else
        rm -rf {{ public }}
        mv {{ stage }}/public {{ public }}
        echo "rafi-participant: {{ public }}"
    fi
    rm -rf {{ stage }}

# Build, then hold the build to its contract (the loader links the glue dx named) and its 280 KB budget.
check: build
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    js=({{ public }}/assets/*.js)
    wasm=({{ public }}/assets/*.wasm)
    if [ "${#js[@]}" -ne 1 ] || [ "${#wasm[@]}" -ne 1 ] || [ ! -f {{ public }}/index.html ] || [ ! -f {{ public }}/fallback.js ]; then
        echo "rafi-participant: not the expected layout in {{ public }}:" >&2
        find {{ public }} >&2
        exit 1
    fi
    name="${js[0]##*/}"
    # A placeholder left in the loader, or another name, would be a page
    # that loads nothing.
    if ! grep -q "assets/$name" {{ public }}/index.html || grep -Eq '\{[a-z_]+\}' {{ public }}/index.html; then
        echo "rafi-participant: index.html doesn't link $name:" >&2
        cat {{ public }}/index.html >&2
        exit 1
    fi
    # The budget: 280 KB compressed (the module and its glue), so the page
    # stays usable on slow venue networks. dx ships the unoptimised module
    # when wasm-opt fails; this catches it.
    wasm_gz=$(wc -c <"${wasm[0]}.gz" | tr -d ' ')
    js_gz=$(wc -c <"${js[0]}.gz" | tr -d ' ')
    total=$((wasm_gz + js_gz))
    echo "rafi-participant: wasm ${wasm_gz} B + js ${js_gz} B = ${total} B gzip -9 ($name)"
    if [ "$total" -gt 286720 ]; then
        echo "rafi-participant: over the 280 KB budget" >&2
        exit 1
    fi

# Remove the build, and the earlier bundles dx leaves in its own output (other hashes).
clean:
    rm -rf {{ dist }} ../../target/dx/rafi-participant/release/web/public
